<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_foodway_inventory_count_recount_wizard_form" model="ir.ui.view">
        <field name="name">foodway.inventory.count.recount.wizard.form</field>
        <field name="model">foodway.inventory.count.recount.wizard</field>
        <field name="arch" type="xml">
            <form string="طلب إعادة العد / Request Recount">
                <sheet>
                    <group>
                        <field name="session_id" readonly="1"/>
                        <field name="recount_scope" widget="radio"/>
                        <field name="line_ids" widget="many2many_tags" invisible="recount_scope != 'selected'" required="recount_scope == 'selected'"/>
                    </group>
                    <group>
                        <field name="reason" placeholder="سبب طلب إعادة العد والتعليمات للموظف..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_process_recount" string="تأكيد طلب إعادة العد" type="object" class="btn-warning"/>
                    <button string="إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_foodway_inventory_count_recount_wizard" model="ir.actions.act_window">
        <field name="name">طلب إعادة العد / Request Recount</field>
        <field name="res_model">foodway.inventory.count.recount.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
