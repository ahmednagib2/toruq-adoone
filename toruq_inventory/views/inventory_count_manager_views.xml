<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action for Manager Sessions -->
    <record id="action_foodway_inventory_count_manager_session" model="ir.actions.act_window">
        <field name="name">إدارة الجرد الأعمى / Manager Inventory Sessions</field>
        <field name="res_model">foodway.inventory.count.session</field>
        <field name="view_mode">list,form,search</field>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_foodway_inventory_count_session_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_foodway_inventory_count_session_form')})]"/>
    </record>

    <!-- Manager View for Lines / Discrepancies -->
    <record id="action_foodway_inventory_count_discrepancy_lines" model="ir.actions.act_window">
        <field name="name">مراجعة الفروقات والأعدَاد / Inventory Discrepancy Review</field>
        <field name="res_model">foodway.inventory.count.line</field>
        <field name="view_mode">list,search</field>
        <field name="domain">[('is_counted', '=', True)]</field>
        <field name="context">{'search_default_discrepancy': 1}</field>
    </record>
</odoo>
