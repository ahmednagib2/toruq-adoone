<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Session List View -->
    <record id="view_foodway_inventory_count_session_list" model="ir.ui.view">
        <field name="name">foodway.inventory.count.session.list</field>
        <field name="model">foodway.inventory.count.session</field>
        <field name="arch" type="xml">
            <list string="جلسات الجرد الأعمى" decoration-info="state == 'opened'" decoration-warning="state == 'recount_requested'" decoration-success="state == 'approved'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="session_name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="start_datetime"/>
                <field name="total_lines_count"/>
                <field name="counted_lines_count"/>
                <field name="uncounted_lines_count"/>
                <field name="discrepancy_lines_count" groups="toruq_inventory.group_inventory_count_manager"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Session Manager Form View -->
    <record id="view_foodway_inventory_count_session_form" model="ir.ui.view">
        <field name="name">foodway.inventory.count.session.form</field>
        <field name="model">foodway.inventory.count.session</field>
        <field name="arch" type="xml">
            <form string="جلسة الجرد الأعمى">
                <header>
                    <button name="action_open" string="فتح الجرد وبدء العد" type="object" class="btn-primary" invisible="state not in ['draft', 'recount_requested']"/>
                    <button name="action_submit" string="إرسال الجلسة للمدير" type="object" class="btn-success" invisible="state not in ['opened', 'recount_in_progress']"/>
                    <button name="%(action_foodway_inventory_count_recount_wizard)d" string="طلب إعادة العد (Recount)" type="action" class="btn-warning" invisible="state != 'submitted'"/>
                    <button name="action_approve" string="اعتماد الجرد وتطبيق التسوية" type="object" class="btn-success fw-bold" invisible="state != 'submitted'" confirm="هل أنت متأكد من اعتماد الجرد؟ سيتم تعديل كميات المخزون في السيستم فوراً ولن يمكنك التراجع."/>
                    <button name="action_cancel" string="إلغاء الجلسة" type="object" class="btn-secondary" invisible="state in ['approved', 'cancelled']" confirm="هل أنت متأكد من إلغاء هذه الجلسة؟"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,opened,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="session_name" placeholder="مثال: جرد الفرع الرئيسي - أكتوبر 2026" readonly="state != 'draft'"/>
                        </h2>
                    </div>

                    <!-- Dedicated Mobile Handheld Quick Scan Terminal -->
                    <div class="card border-primary shadow-lg mb-4" invisible="state not in ['opened', 'recount_in_progress']" style="border-radius: 15px; overflow: hidden;">
                        <div class="card-header bg-primary text-white text-center py-2">
                            <h3 class="mb-0 fw-bold">📱 واجهة المسح السريع للجوال والـ Handheld</h3>
                        </div>
                        <div class="card-body p-3 bg-light">
                            <!-- 1. Barcode Field -->
                            <div class="mb-3 text-center">
                                <label for="scan_barcode" class="form-label fw-bold fs-4 text-primary">📷 اضغط هنا ثم امسح الباركود بالماكينة:</label>
                                <field name="scan_barcode" placeholder="امسح الباركود أو ادخله..." class="form-control form-control-lg text-center fw-bold fs-2 border-2 border-primary shadow-sm" style="height: 55px; font-size: 26px !important; border-radius: 10px;"/>
                            </div>

                            <!-- 2. Quick Quantity Buttons (1, 2, 5, 10, 12, 24, 50) -->
                            <div class="mb-3 text-center">
                                <label class="form-label fw-bold fs-5 text-secondary">🔢 اختر الكمية بضغطة زر واحدة لمسحها:</label>
                                <div class="d-flex justify-content-center gap-2 flex-wrap mb-2">
                                    <button name="action_set_qty_1" type="object" string="1" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_2" type="object" string="2" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_5" type="object" string="5" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_10" type="object" string="10" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_12" type="object" string="12" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_24" type="object" string="24" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                    <button name="action_set_qty_50" type="object" string="50" class="btn btn-outline-primary btn-lg fw-bold fs-3 px-3 py-1 shadow-sm" style="min-width: 60px; border-radius: 8px;"/>
                                </div>
                                <div class="d-flex justify-content-center align-items-center gap-3 mt-2">
                                    <span class="fw-bold fs-5">الكمية المحددة:</span>
                                    <field name="scan_qty" class="form-control form-control-lg text-center fw-bold fs-4 text-primary border-primary" style="max-width: 120px; border-radius: 8px;"/>
                                    <field name="scan_mode" widget="radio" class="fw-bold fs-6"/>
                                </div>
                            </div>

                            <!-- 3. Huge Confirm & Save Count Button -->
                            <div class="mt-3 text-center">
                                <button name="action_scan_barcode" type="object" string="✅ تأكيد وحفظ عدد المنتج (تصفير ومسح جديد ⏎)" class="btn btn-success btn-lg w-100 py-3 fs-2 fw-bold shadow-lg" style="border-radius: 12px;"/>
                            </div>
                        </div>
                    </div>

                    <!-- Last Scan Feedback Banner -->
                    <div class="card p-3 mb-3 bg-success-subtle border-success shadow-sm" invisible="not last_scanned_product_id">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success fs-6">✅ تم الحفظ والتراكم بنجاح والتصفير جاهز للمنتج الجديد</span>
                            <span class="text-muted"><field name="last_scanned_time" readonly="1"/></span>
                        </div>
                        <group col="4">
                            <field name="last_scanned_product_id" readonly="1"/>
                            <field name="last_scanned_previous_qty" readonly="1"/>
                            <field name="last_scanned_added_qty" readonly="1"/>
                            <field name="last_scanned_new_qty" class="fw-bold text-success fs-4" readonly="1"/>
                        </group>
                    </div>

                    <group col="2">
                        <group string="إعدادات ونطاق الجرد">
                            <field name="company_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="warehouse_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="location_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="include_child_locations" readonly="state != 'draft'"/>
                            <field name="product_scope" widget="radio" readonly="state != 'draft'"/>
                            <field name="category_ids" widget="many2many_tags" invisible="product_scope != 'category'" readonly="state != 'draft'"/>
                            <field name="product_ids" widget="many2many_tags" invisible="product_scope != 'products'" readonly="state != 'draft'"/>
                            <field name="assigned_user_ids" widget="many2many_tags" readonly="state not in ['draft', 'opened', 'recount_in_progress']"/>
                        </group>
                        <group string="إحصائيات وتتبع الجلسة">
                            <field name="start_datetime" readonly="1"/>
                            <field name="opened_by_user_id" readonly="1"/>
                            <field name="submitted_datetime" readonly="1"/>
                            <field name="submitted_by_user_id" readonly="1"/>
                            <field name="approved_datetime" readonly="1"/>
                            <field name="approved_by_user_id" readonly="1"/>
                            <field name="recount_round" readonly="1"/>
                            <field name="total_lines_count"/>
                            <field name="counted_lines_count"/>
                            <field name="uncounted_lines_count"/>
                            <field name="discrepancy_lines_count" groups="toruq_inventory.group_inventory_count_manager"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="سطور الجرد والتسوية / Count Lines">
                            <field name="line_ids" readonly="state in ['submitted', 'approved', 'cancelled']">
                                <list string="سطور الجرد" editable="bottom" create="false" delete="false" decoration-danger="inventory_difference != 0 and is_counted" decoration-success="is_counted and inventory_difference == 0">
                                    <field name="product_id" readonly="1"/>
                                    <field name="barcode" readonly="1"/>
                                    <field name="location_id" readonly="1"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="lot_id"/>
                                    <field name="is_counted" readonly="1"/>
                                    <field name="counted_qty"/>
                                    <field name="counted_by_user_id" readonly="1"/>
                                    <field name="count_datetime" readonly="1"/>
                                    <field name="system_qty_snapshot" groups="toruq_inventory.group_inventory_count_manager" readonly="1"/>
                                    <field name="stock_movement_qty" groups="toruq_inventory.group_inventory_count_manager" readonly="1"/>
                                    <field name="expected_qty_at_count" groups="toruq_inventory.group_inventory_count_manager" readonly="1"/>
                                    <field name="inventory_difference" groups="toruq_inventory.group_inventory_count_manager" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="سجل عمليات الباركود / Barcode Scan Log">
                            <field name="entry_ids" readonly="1">
                                <list string="عمليات المسح" create="false" delete="false">
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="product_id"/>
                                    <field name="operation_type"/>
                                    <field name="previous_qty"/>
                                    <field name="input_qty"/>
                                    <field name="new_qty"/>
                                </list>
                            </field>
                        </page>

                        <page string="سجل تتبع التعديلات والتدقيق / Audit Trail">
                            <field name="audit_log_ids" readonly="1">
                                <list string="سجل التدقيق" create="false" delete="false">
                                    <field name="timestamp"/>
                                    <field name="user_id"/>
                                    <field name="action"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>

                        <page string="حركات المخزون المنفذة / Stock Adjustment Moves" invisible="not adjustment_applied" groups="toruq_inventory.group_inventory_count_manager">
                            <field name="adjustment_move_ids" readonly="1">
                                <list string="حركات المخزون">
                                    <field name="date"/>
                                    <field name="reference"/>
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="product_uom_qty"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_foodway_inventory_count_session_search" model="ir.ui.view">
        <field name="name">foodway.inventory.count.session.search</field>
        <field name="model">foodway.inventory.count.session</field>
        <field name="arch" type="xml">
            <search string="بحث جلسات الجرد">
                <field name="name"/>
                <field name="session_name"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="assigned_user_ids"/>
                <filter string="جارية / In Progress" name="in_progress" domain="[('state', 'in', ['opened', 'recount_in_progress'])]"/>
                <filter string="مرفوعة للمراجعة / Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="معتمدة / Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="المستودع" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="الموقع" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="الحالة" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
