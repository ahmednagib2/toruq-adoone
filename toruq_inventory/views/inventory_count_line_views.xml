<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_foodway_inventory_count_line_tree" model="ir.ui.view">
        <field name="name">foodway.inventory.count.line.tree</field>
        <field name="model">foodway.inventory.count.line</field>
        <field name="arch" type="xml">
            <list string="سطور الجرد الأعمى" create="false" delete="false">
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="barcode"/>
                <field name="location_id"/>
                <field name="product_uom_id"/>
                <field name="lot_id"/>
                <field name="is_counted"/>
                <field name="counted_qty"/>
                <field name="counted_by_user_id"/>
                <field name="count_datetime"/>
                <field name="system_qty_snapshot" groups="toruq_inventory.group_inventory_count_manager"/>
                <field name="expected_qty_at_count" groups="toruq_inventory.group_inventory_count_manager"/>
                <field name="inventory_difference" groups="toruq_inventory.group_inventory_count_manager"/>
            </list>
        </field>
    </record>

    <record id="view_foodway_inventory_count_line_search" model="ir.ui.view">
        <field name="name">foodway.inventory.count.line.search</field>
        <field name="model">foodway.inventory.count.line</field>
        <field name="arch" type="xml">
            <search string="بحث سطور الجرد">
                <field name="session_id"/>
                <field name="product_id"/>
                <field name="barcode"/>
                <field name="location_id"/>
                <filter string="تم عَدها" name="counted" domain="[('is_counted', '=', True)]"/>
                <filter string="لم تُعد بعد" name="uncounted" domain="[('is_counted', '=', False)]"/>
                <filter string="يوجد عجز/زيادة (فروقات)" name="discrepancy" domain="[('is_counted', '=', True), ('inventory_difference', '!=', 0)]" groups="toruq_inventory.group_inventory_count_manager"/>
                <group expand="0" string="تجميع حسب">
                    <filter string="الجلسة" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="المنتج" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="الموقع" name="group_location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
