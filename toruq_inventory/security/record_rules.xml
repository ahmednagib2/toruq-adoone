<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Multi-Company Rule for Session -->
        <record id="rule_session_multi_company" model="ir.rule">
            <field name="name">Inventory Count Session Multi-Company Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_session"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Employee Rule: Can only see sessions assigned to them -->
        <record id="rule_session_employee_assigned" model="ir.rule">
            <field name="name">Employee Session Assignment Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_session"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_employee'))]"/>
            <field name="domain_force">[('assigned_user_ids', 'in', [user.id])]</field>
        </record>

        <!-- Employee Rule: Can only access lines for assigned sessions -->
        <record id="rule_line_employee_assigned" model="ir.rule">
            <field name="name">Employee Line Assignment Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_line"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_employee'))]"/>
            <field name="domain_force">[('session_id.assigned_user_ids', 'in', [user.id])]</field>
        </record>

        <!-- Manager Rule: Full access to all sessions in company -->
        <record id="rule_session_manager_all" model="ir.rule">
            <field name="name">Manager Session Full Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_session"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="rule_line_manager_all" model="ir.rule">
            <field name="name">Manager Line Full Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_line"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- Employee Rule: Entry Audit Log Isolation -->
        <record id="rule_entry_employee_assigned" model="ir.rule">
            <field name="name">Employee Entry Audit Assignment Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_entry"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_employee'))]"/>
            <field name="domain_force">[('session_id.assigned_user_ids', 'in', [user.id])]</field>
        </record>

        <!-- Manager Rule: Entry Audit Log Full Access -->
        <record id="rule_entry_manager_all" model="ir.rule">
            <field name="name">Manager Entry Audit Full Rule</field>
            <field name="model_id" ref="model_foodway_inventory_count_entry"/>
            <field name="groups" eval="[(4, ref('group_inventory_count_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
