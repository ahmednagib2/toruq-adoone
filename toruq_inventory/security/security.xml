<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="category_blind_inventory_count" model="ir.module.category">
            <field name="name">Blind Inventory Count / الجرد الأعمى</field>
            <field name="description">Security groups for Blind Inventory Count module</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_inventory_count_employee" model="res.groups">
            <field name="name">Inventory Count Employee / موظف الجرد الأعمى</field>
            <field name="category_id" ref="category_blind_inventory_count"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Employee restricted strictly to blind counting interface. Zero stock theoretical level visibility.</field>
        </record>

        <record id="group_inventory_count_manager" model="res.groups">
            <field name="name">Inventory Count Manager / مدير الجرد الأعمى</field>
            <field name="category_id" ref="category_blind_inventory_count"/>
            <field name="implied_ids" eval="[(4, ref('group_inventory_count_employee')), (4, ref('stock.group_stock_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Full managerial access to inventory sessions, theoretical stock reconciliation, recounts, and approval adjustments.</field>
        </record>
    </data>
</odoo>
